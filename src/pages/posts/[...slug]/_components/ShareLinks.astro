---
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<div
  class="flex flex-none flex-col items-center gap-2 md:items-start"
  data-article-share
>
  <span>{t.post.sharePostIntro}</span>
  <div class="flex flex-wrap items-center gap-2">
    <button
      type="button"
      data-copy-share-link
      data-copy-label={t.post.copyLink}
      data-copied-label={t.post.linkCopied}
      class="border-border hover:border-accent hover:text-accent inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm transition-colors"
      title={t.post.copyLink}
      aria-label={t.post.copyLink}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-4"
        aria-hidden="true"
      >
        <path d="M10 13a5 5 0 0 0 7.07.07l2-2a5 5 0 0 0-7.07-7.07l-1.15 1.15"
        ></path>
        <path d="M14 11a5 5 0 0 0-7.07-.07l-2 2A5 5 0 0 0 12 20l1.15-1.15"
        ></path>
      </svg>
      <span data-copy-share-label>{t.post.copyLink}</span>
    </button>
    <button
      type="button"
      data-system-share
      data-fallback-copied={t.post.shareFallbackCopied}
      data-fallback-manual={t.post.shareFallbackManual}
      class="border-border hover:border-accent hover:text-accent inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm transition-colors"
      title={t.post.systemShareHint}
      aria-label={t.post.systemShare}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-4"
        aria-hidden="true"
      >
        <path d="M12 16V3"></path>
        <path d="m7 8 5-5 5 5"></path>
        <path d="M5 13v7h14v-7"></path>
      </svg>
      <span>{t.post.systemShare}</span>
    </button>
  </div>
  <span
    class="text-muted-foreground min-h-4 text-xs"
    role="status"
    data-share-status></span>
</div>

<script is:inline data-astro-rerun>
  (() => {
    if (window.__articleShareBound) return;
    window.__articleShareBound = true;

    const getUrl = () =>
      document.querySelector('link[rel="canonical"]')?.href ??
      window.location.href.split("#")[0];

    const copyUrl = async url => {
      try {
        await navigator.clipboard.writeText(url);
        return true;
      } catch {
        const textArea = document.createElement("textarea");
        textArea.value = url;
        textArea.setAttribute("readonly", "");
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.appendChild(textArea);
        textArea.select();
        try {
          return document.execCommand("copy");
        } finally {
          textArea.remove();
        }
      }
    };

    document.addEventListener("click", async event => {
      const target =
        event.target instanceof Element
          ? event.target.closest(
              "[data-copy-share-link], [data-system-share]"
            )
          : null;
      if (!(target instanceof HTMLButtonElement)) return;

      const status = target
        .closest("[data-article-share]")
        ?.querySelector("[data-share-status]");
      if (status) status.textContent = "";
      const url = getUrl();

      if (target.hasAttribute("data-system-share")) {
        if (typeof navigator.share === "function") {
          const title =
            document.querySelector('meta[property="og:title"]')?.content ??
            document.title;
          try {
            await navigator.share({ title, url });
          } catch (error) {
            if (error?.name !== "AbortError" && status) {
              status.textContent = target.dataset.fallbackManual ?? "";
            }
          }
        } else {
          try {
            const copied = await copyUrl(url);
            if (status) {
              status.textContent = copied
                ? (target.dataset.fallbackCopied ?? "")
                : (target.dataset.fallbackManual ?? "");
            }
          } catch {
            if (status)
              status.textContent = target.dataset.fallbackManual ?? "";
          }
        }
        return;
      }

      try {
        const copied = await copyUrl(url);
        if (!copied) return;
      } catch {
        return;
      }

      const label = target.querySelector("[data-copy-share-label]");
      const copyLabel = target.dataset.copyLabel ?? "Copy link";
      const copiedLabel = target.dataset.copiedLabel ?? "Copied";
      if (label) label.textContent = copiedLabel;
      target.title = copiedLabel;
      target.setAttribute("aria-label", copiedLabel);

      window.setTimeout(() => {
        if (label) label.textContent = copyLabel;
        target.title = copyLabel;
        target.setAttribute("aria-label", copyLabel);
      }, 1600);
    });
  })();
</script>
