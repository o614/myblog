---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  headline?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
};

const { site, socials } = config;

const {
  title,
  headline,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags = [],
} = Astro.props;

const resolvedCanonicalURL =
  canonicalURL ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const articleStructuredData = {
  "@type": "BlogPosting",
  "@id": `${resolvedCanonicalURL}#article`,
  headline: headline ?? title ?? site.title,
  ...(description && { description }),
  image: ogImage,
  inLanguage: site.lang,
  ...(tags.length > 0 && { keywords: tags }),
  ...(resolvedCanonicalURL && {
    url: resolvedCanonicalURL,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": resolvedCanonicalURL,
    },
  }),
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
      ...(socials.length > 0 && { sameAs: socials.map(({ url }) => url) }),
    },
  ],
  publisher: {
    "@type": "Organization",
    "@id": `${site.url}#publisher`,
    name: site.title,
    url: site.url,
  },
};

const breadcrumbStructuredData = {
  "@type": "BreadcrumbList",
  "@id": `${resolvedCanonicalURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首页",
      item: site.url,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "文章",
      item: new URL("posts/", site.url).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: headline ?? title ?? site.title,
      item: resolvedCanonicalURL,
    },
  ],
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [articleStructuredData, breadcrumbStructuredData],
};
---

<Layout
  {title}
  {description}
  {ogImage}
  canonicalURL={resolvedCanonicalURL}
  ogType="article"
>
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
